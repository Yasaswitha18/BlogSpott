# Server Configuration
# PORT is automatically set by Render in production; defaults to 3000 locally
PORT=3000
NODE_ENV=production

# Database Connection (Neon PostgreSQL)
# Render typically provides this as CONNECTION_STRING or DATABASE_URL
# Example: postgres://username:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
CONNECTION_STRING=postgres://username:password@hostname:5432/database?sslmode=require

# Authentication Secrets
# Generate a strong, secure random string for JWT signing (e.g., via `openssl rand -hex 32`)
ACCESS_TOKEN_SECRET=your_jwt_access_token_secret_here

# Email Verification & Password Reset Service (Nodemailer via Gmail)
# MAIL_ID: The Gmail address used to dispatch verification and password reset emails
MAIL_ID=your_email@gmail.com
# MAIL_PASSWORD: Use a Google App Password (not your personal Google account password)
# Generated at https://myaccount.google.com/apppasswords
MAIL_PASSWORD=your_google_app_password

# Application Host / Domain for Email Links
# This is the domain or full URL where the app is reached.
# Used to construct account verification and password reset links.
# Example on Render: blogspot-ge1x.onrender.com or https://blogspot-ge1x.onrender.com
DOMAIN=your-app-name.onrender.com

# Optional: CORS Allowed Origins (comma-separated if multiple, or leave blank to accept same-origin/all)
CLIENT_ORIGIN=
